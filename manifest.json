{
  "manifest_version": 3,
  "name": "ChatGPT Image Downloader",
  "version": "2.1.3",
  "description": "Download ChatGPT images to a folder you pick, and batch-run image prompts one after another.",
  "permissions": [
    "contextMenus",
    "downloads",
    "offscreen",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Image Downloader"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js",
        "automation.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "picker.html"
}
